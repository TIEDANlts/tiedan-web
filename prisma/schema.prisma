generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// 键值配置：站点标题、个人简介、上次 Steam 同步时间等
model Setting {
  key   String @id
  value String
}

model Link {
  id          String  @id @default(cuid())
  group       String
  title       String
  url         String
  icon        String?
  description String?
  sort        Int     @default(0)
}

model Todo {
  id        String    @id @default(cuid())
  content   String
  date      DateTime? @db.Date
  priority  Int       @default(0)
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
}
