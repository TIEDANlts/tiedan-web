generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// 键值配置：站点标题、个人简介、上次 Steam 同步时间等
model Setting {
  key   String @id
  value String
}
