# Docker image pushed by the manual deploy workflow.
APP_IMAGE=registry.cn-hangzhou.aliyuncs.com/namespace/tiedan-web:latest
REGISTRY_HOST=registry.cn-hangzhou.aliyuncs.com
REGISTRY_IMAGE=registry.cn-hangzhou.aliyuncs.com/namespace/tiedan-web
SERVER_DEPLOY_PATH=/data/tiedan-web

# Public site settings.
SITE_DOMAIN=example.com
SITE_URL=https://example.com
ICP_BEIAN_NO=
GONGAN_BEIAN_NO=
TZ=Asia/Shanghai
UPLOAD_DIR=/data/uploads
OUTBOUND_PROXY=

# PostgreSQL inside docker-compose.prod.yml.
POSTGRES_DB=personal_site
POSTGRES_USER=personal_site
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://personal_site:change-me@postgres:5432/personal_site

# Auth.js and the single admin account.
AUTH_SECRET=replace-with-openssl-rand-base64-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-password

# Encrypted backups and future scheduled jobs.
BACKUP_REMOTE=backup-crypt:tiedan-web
BACKUP_RETENTION_DAYS=30
HEALTHCHECKS_BACKUP_URL=
HEALTHCHECKS_STEAM_URL=
CRON_SECRET=

# Future integrations.
STEAM_API_KEY=
STEAM_ID=
TMDB_API_KEY=
QUICK_ADD_TOKEN=
TIANDITU_KEY=
